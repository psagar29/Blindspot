{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "skipLibCheck": true, "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "../../src/engine/**/*.ts"],
  "exclude": ["../../src/engine/**/*.test.ts", "../../src/engine/scene.ts", "../../src/engine/depth.ts"]
}
