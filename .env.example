# Copy to .env.local; fill privately. Values intentionally blank.
# CLI-only. Never import in application code or prefix with VITE_.
CONVEX_DEPLOY_KEY=
# Public browser configuration, not a credential.
VITE_CONVEX_URL=
# Public deployed frontend origin, used for controller QR and report share links.
VITE_PUBLIC_APP_ORIGIN=
# Local Node provider service only. Never upload these to a hosting provider.
WORLD_LABS_API_KEY=
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_ID=
PROVIDER_PORT=8788
# Local authoring proxy is disabled on the public controller/report deployment.
VITE_AUTHORING_ENABLED=false
# Public immutable report used to preload the hosted judge demo.
VITE_DEMO_REPORT_ID=
