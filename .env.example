# Blindspot frontend environment (public configuration only — no secrets here).
# Copy to .env.local and fill privately. Never commit .env.local.
# Provider secrets (World Labs, Tripo, Convex deploy key) belong in the local
# provider service environment (services/provider/), never in VITE_* variables.

# Convex Cloud client URL (public, not secret). React client takes the cloud URL.
VITE_CONVEX_URL=

# Deployed HTTPS origin used to build controller/report share links.
# If unset, sharing is disabled with a setup message. Localhost is never the public origin.
VITE_PUBLIC_APP_ORIGIN=

# "false" on the public deployment: authoring controls show read-only guidance.
VITE_AUTHORING_ENABLED=
